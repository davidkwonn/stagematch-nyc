# Edge function secrets: set them in Lovable Cloud → Secrets. Never commit real values: this repo is public.
# Provided automatically to edge functions: SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY, LOVABLE_API_KEY.
APP_URL=

# Mack text agent: Lovable AI gateway by default (LOVABLE_API_KEY). Set these only to use another OpenAI-compatible endpoint.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Mack voice
OPENAI_API_KEY=
VOICE_MODEL=gpt-live-1
VOICE_NAME=marin
JEV_API_KEY=

# Payments
WHOP_API_KEY=
WHOP_COMPANY_ID=
WHOP_WEBHOOK_SECRET=
WHOP_SIMULATE=true
# sandbox while testing; production keys + WHOP_ENV=production before sharing links (sandbox sales don't count)
WHOP_ENV=sandbox

# Vetting
TERAC_API_KEY=
TERAC_SIMULATE=true
# Optional: reuse one Terac project or a hand-launched opportunity, reviewers per artist, hard filters JSON (ids from GET /filters)
TERAC_PROJECT_ID=
TERAC_OPPORTUNITY_ID=
TERAC_REVIEWERS=1
TERAC_FILTERS=

CRON_SECRET=

# scripts/seed.ts: password for every seeded example.com account (local only, not a function secret)
SEED_PASSWORD=
